// Who holds the heap, for `horizon-ctl memory` (feature `alloc-census`, for
// measuring only): mimalloc with a tag in front of each block, and the live
// bytes of each tag. A block's tag is what ran on its thread when it was
// allocated: the innermost [`tag`] (a startup step, a timed span or a pool
// job: `startup::time`, `spans::time` and `jobs` set them), else the
// thread's name. A block keeps its tag when another thread frees or grows
// it, so a column generated by a pool job and kept by the server thread
// counts for the job.
//
// Each block costs a header of 16 bytes (its alignment when larger) and an
// atomic add: heaptrack's interpreter needed more than 7 GB for the game
// (18 GB with line tables), this needs nothing beside it.
// use std::{
    // rust: alloc::{GlobalAlloc, Layout},
    // rust: cell::Cell,
    // rust: sync::atomic::{AtomicIsize, AtomicPtr, AtomicUsize, Ordering::Relaxed},
}

TAGS :: 512
// Blocks allocated while this thread names itself, and past the table's end.
UNTAGGED :: 0
NONE :: u32::MAX

LIVE :: [const { AtomicIsize::new(0) }; TAGS]
NAME_PTR :: [const { AtomicPtr::new(std::ptr::null_mut()) }; TAGS]
NAME_LEN :: [const { AtomicUsize::new(0) }; TAGS]
// The next free slot; slot 0 is [`UNTAGGED`].
NEXT :: AtomicUsize::new(1)

    // rust: thread_local! {
STEP :: const { Cell::new(NONE) }
THREAD :: const { Cell::new(NONE) }
    // Allocations this thread made before its tag settled: std names a
    // thread after its first few, so the name is read again until then.
NAMING :: const { Cell::new(0) }
BUSY :: const { Cell::new(false) }
}

