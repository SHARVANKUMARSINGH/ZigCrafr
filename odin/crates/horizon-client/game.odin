}
//         use winit::keyboard::ModifiersState;
    // rust: for (state, bits) in [
    // rust: (ModifiersState::empty(), 0),
    // rust: (ModifiersState::SHIFT, 1),
    // rust: (ModifiersState::CONTROL, 2),
    // rust: (ModifiersState::ALT, 4),
    // rust: (ModifiersState::SUPER, 8),
