    left: bool,
    right: bool,
    cursor: (f32,
    // The cursor icon the window shows (`widgets::take_cursor` each frame).
    cursor_icon: horizon_client::widgets::Cursor,
    captured: bool,
    // Native grab mode used by winit. Linux window managers can drop the
