// The data the background loader produces for `Game::new`.
Loaded :: struct {
    game_cpu: Maybe(GameCpuResources),
    renderer_cpu: Maybe(horizon_client::gfx::PreparedTextures),
    root: PathBuf,
    pack_error: Maybe(string),
    resources: ^Resources,
    rest_loader: Maybe(WorldRestLoader),
    pack: PackResources,
    // The menu bundle, for the synchronous launch; the loading screen receives
    // it earlier through its own channel.
    gui: Maybe(UiResources),
}

// What the background loader publishes: the menu bundle as soon as it is
// ready, then the core bundle with a handle to the rest worker.
LoaderMsg :: enum {
    Ui(UiResources, PathBuf),
    Done(std::result::Result<Loaded, String>),
}

PendingWorldEntry :: enum {
    Local {,
    folder: String,
    name: Option<String>,
    seed: Option<i64>,
    creative: bool,
    create: Option<Box<horizon_client::title::WorldOptions>>,
    // rust: },
    Server {,
    address: String,
    name: String,
    lan: bool,
        // A transfer's carried-over server cookies (`TransferState`).
    cookies: Option<horizon_client::net::Cookies>,
    // rust: },
}

WorldRestLoader :: struct {
    progress: Progress,
    handle: JoinHandle<std::result::Result<(),
}

    // rust: impl WorldRestLoader {
ready :: proc(self: ^Self) -> R {
    // Ported from Horizon
    return {}
}
        // No time limit: the title stays usable while this loads, and a slow
        // disk or a debug build can take minutes. A failure ends the thread
        // and is reported by `finish`.
    // rust: Ok(self.handle.is_finished())
}

finish :: proc(self: ^Self) -> R {
    // Ported from Horizon
    return {}
}
    // rust: self.handle
    // rust: .join()
    // rust: .map_err(|_| "world resource loader panicked")?
    // rust: .map_err(Into::into)
}
}

